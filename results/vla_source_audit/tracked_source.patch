--- a/cloud/launch.py
+++ b/cloud/launch.py
@@ -27,0 +28,4 @@ ZONES = ("us-central1-c", "us-central1-b", "us-central1-a")
+WORKLOAD_CONFIGS = {
+    "qwen-pilot": CONFIG,
+    "molmo-openloop": ROOT / "experiments/configs/cloud_molmo_openloop.json",
+}
@@ -67,0 +72,3 @@ def plan(project: str, cfg: dict, name: str) -> dict:
+    workload = cfg.get("workload", "qwen-pilot")
+    if workload not in WORKLOAD_CONFIGS:
+        raise ValueError("unsupported workload")
@@ -80,0 +88 @@ def plan(project: str, cfg: dict, name: str) -> dict:
+        "workload": workload,
@@ -105,0 +114 @@ def create_command(p: dict, sha: str, archive_hash: str, startup: Path | None =
+        "dream-workload": p.get("workload", "qwen-pilot"),
@@ -129 +138 @@ def create_command(p: dict, sha: str, archive_hash: str, startup: Path | None =
-        "--labels=dream=1,purpose=qwen-pilot",
+        f"--labels=dream=1,purpose={p.get('workload', 'qwen-pilot')}",
@@ -188 +197 @@ def allocate(p: dict, sha: str, checksum: str, startup: Path, dest: Path) -> Non
-def check_pilot(out: Path) -> None:
+def check_pilot(out: Path, workload: str = "qwen-pilot") -> None:
@@ -191,0 +201,21 @@ def check_pilot(out: Path) -> None:
+    if workload == "molmo-openloop":
+        path = out / "molmo/summary.json"
+        if not path.is_file():
+            raise RuntimeError("action summary missing")
+        summary = json.loads(path.read_text())
+        if (
+            summary.get("real_model_executed") is not True
+            or summary.get("finite") is not True
+            or summary.get("shape") != [15, 8]
+            or summary.get("execution_permitted") is not False
+            or not (out / "molmo/raw_actions.npy").is_file()
+        ):
+            raise RuntimeError("open-loop inference gate failed")
+        import numpy as np
+
+        actions = np.load(out / "molmo/raw_actions.npy", allow_pickle=False)
+        if actions.shape != (15, 8) or not np.isfinite(actions).all():
+            raise RuntimeError("saved action tensor is invalid")
+        return
+    if workload != "qwen-pilot":
+        raise ValueError("unsupported workload")
@@ -468 +498 @@ def _launch(p: dict, allowance: float) -> None:
-    check_pilot(dest / "out")
+    check_pilot(dest / "out", p.get("workload", "qwen-pilot"))
@@ -480 +510,5 @@ def recover(manifest: Path, yes: bool) -> None:
-    cfg = {**json.loads(CONFIG.read_text()), "zone": p["zone"]}
+    workload = p.get("workload", "qwen-pilot")
+    if workload not in WORKLOAD_CONFIGS:
+        raise ValueError("unsupported recovery workload")
+    config_path = CONFIG if workload == "qwen-pilot" else WORKLOAD_CONFIGS[workload]
+    cfg = {**json.loads(config_path.read_text()), "zone": p["zone"]}
@@ -513,0 +548 @@ def main() -> None:
+    ap.add_argument("--workload", choices=list(WORKLOAD_CONFIGS), default="qwen-pilot")
@@ -520 +555 @@ def main() -> None:
-    cfg = json.loads(CONFIG.read_text())
+    cfg = json.loads(WORKLOAD_CONFIGS[args.workload].read_text())
diff --git a/cloud/vm_startup.sh b/cloud/vm_startup.sh
index a158ff4..88fcddd 100644
--- a/cloud/vm_startup.sh
+++ b/cloud/vm_startup.sh
@@ -13,0 +14 @@ CAP=$(meta instance/attributes/dream-max-minutes)
+WORKLOAD=$(meta instance/attributes/dream-workload)
@@ -55 +56,3 @@ source /work/venv/bin/activate
-uv pip install --require-hashes -r /work/DREAM/cloud/requirements.lock.txt
+LOCK=requirements.lock.txt
+[ "$WORKLOAD" = molmo-openloop ] && LOCK=molmo.requirements.lock.txt
+uv pip install --require-hashes -r "/work/DREAM/cloud/$LOCK"
@@ -62,2 +65,9 @@ LEFT=$(( CAP * 60 - 120 - UP ))
-timeout --signal=TERM --kill-after=30s "${LEFT}s" \
-  python experiments/cloud_qwen_pilot.py --out /work/out/pilot
+case "$WORKLOAD" in
+  qwen-pilot)
+    timeout --signal=TERM --kill-after=30s "${LEFT}s" \
+      python experiments/cloud_qwen_pilot.py --out /work/out/pilot ;;
+  molmo-openloop)
+    timeout --signal=TERM --kill-after=30s "${LEFT}s" \
+      python experiments/cloud_molmo_openloop.py --out /work/out ;;
+  *) echo "Unsupported workload: $WORKLOAD"; exit 2 ;;
+esac
